# Copy to .env and fill in. .env is gitignored -- never commit it.

# --- App ------------------------------------------------------------------
# Signs session cookies. Generate with: openssl rand -base64 48
SECRET_KEY=
DEBUG=1
# Comma separated. Include the tailnet IP/host you browse from.
# Add your own host/IP (e.g. a tailnet address) if you reach it remotely.
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Postgres -------------------------------------------------------------
# Consumed both by the postgres container and by DATABASE_URL in web/worker.
POSTGRES_DB=bunko
POSTGRES_USER=bunko
POSTGRES_PASSWORD=

# --- LLM provider ---------------------------------------------------------
# Ollama runs on the MacBook over the tailnet (OpenAI-compatible API).
# The DB ProviderProfile.base_url is seeded from this on first run; the tailnet
# IP can change if the MacBook's node key rotates, so it lives here, not in code.
# Point this at wherever Ollama runs (localhost, or another machine).
OLLAMA_BASE_URL=http://localhost:11434/v1
# Empty for local Ollama.
OLLAMA_API_KEY=

# --- Tagging worker -------------------------------------------------------
TAGGING_POLL_SECONDS=2

# --- Dev bind address -----------------------------------------------------
# Bind to the tailnet IP only, so this is not exposed on LAN or the internet.
# Use 127.0.0.1 to keep it to this machine.
# 127.0.0.1 keeps it local. Use 0.0.0.0 or a specific address to expose it.
BIND_HOST=127.0.0.1
WEB_PORT=8000
# Vite dev server with hot reload.
FRONTEND_PORT=5173
