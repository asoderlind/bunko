# Copy to .env and fill in. .env is gitignored -- never commit it.

# --- Django ---------------------------------------------------------------
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
# Comma separated. Include the tailnet IP/host you browse from.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,100.113.71.15

# --- Postgres -------------------------------------------------------------
# Consumed both by the postgres container and by DATABASE_URL in web/worker.
POSTGRES_DB=easy_notes
POSTGRES_USER=easy_notes
POSTGRES_PASSWORD=

# --- LLM provider ---------------------------------------------------------
# Ollama runs on the MacBook over the tailnet (OpenAI-compatible API).
# The DB ProviderProfile.base_url is seeded from this on first run; the tailnet
# IP can change if the MacBook's node key rotates, so it lives here, not in code.
OLLAMA_BASE_URL=http://100.111.126.52:11434/v1
# Empty for local Ollama.
OLLAMA_API_KEY=

# --- Tagging worker -------------------------------------------------------
TAGGING_POLL_SECONDS=2

# --- Dev bind address -----------------------------------------------------
# Bind to the tailnet IP only, so this is not exposed on LAN or the internet.
# Use 127.0.0.1 to keep it to this machine.
BIND_HOST=100.113.71.15
WEB_PORT=8000
