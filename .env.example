# Copy to .env and fill in. .env is gitignored -- never commit it.

# --- App ------------------------------------------------------------------
# Signs session cookies. Generate with: openssl rand -base64 48
SECRET_KEY=
DEBUG=1
# Comma separated. Include the host/IP you browse from.
ALLOWED_HOSTS=localhost,127.0.0.1

# SQLite database path inside the container. The compose file mounts ./data
# at /data, so this survives container rebuilds.
DATABASE_URL=sqlite:////data/bunko.sqlite3

# --- LLM provider ---------------------------------------------------------
# Ollama or another OpenAI-compatible API. This can point to a separate
# machine, including a Tailscale hostname or IP.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=
OLLAMA_MODEL=llama3.1:8b

# --- Tagging worker -------------------------------------------------------
TAGGING_POLL_SECONDS=2

# --- Dev bind address -----------------------------------------------------
# Use 127.0.0.1 to keep development local, or a tailnet address for access
# from other tailnet devices.
BIND_HOST=127.0.0.1
WEB_PORT=8000
FRONTEND_PORT=5173
